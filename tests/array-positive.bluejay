# Support of Global array
var arr[20] int;
var x int := 2;
var str[20] string;

fun f void ()
  str[0] := "B";
  arr[0] := 1;
  return;

fun farg int (i int, s string)
    printint(i);
    printstring(s);
    return 0;

# Initialize the index 0
str[0] := "A";
arr[0] := 0;

printint(arr[0]);
printstring(str[0]);

# Overwrite the index 0
f();

printint(arr[0]);
printstring(str[0]);

# Lets write something in other index
arr[0] := arr[0] +  arr[0];

arr[arr[0]+arr[0]] := 2024;
str[arr[0]+arr[0]] := "UIC";

printint(arr[arr[0]+arr[0]]);
printstring(str[arr[0]+arr[0]]);

# Pass as arg
exit(farg(arr[0], str[0]));